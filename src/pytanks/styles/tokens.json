{
  "_comment": "Design tokens shared with chargetanks.com (assets/js/site/chapter.js, assets/css/site.css). pytanks is the reference: the website tests its drawing code against this file.",
  "version": 2,
  "colors": {
    "anode": "#70ad47",
    "cathode": "#f39c12",
    "water": "#5dade2",
    "ceiling": "#b8c2cc",
    "navy": "#003b73",
    "blue_text": "#1d6fa5"
  },
  "themes": {
    "site": {
      "_comment": "Look of chargetanks.com: navy background, white lines and text.",
      "background": "#003b73",
      "panel": "#0b4678",
      "ink": "#e6eaf1",
      "cell": "#ffffff",
      "muted": "#8ca7c0",
      "grid": "#1f5284",
      "window": "#2a6aa3",
      "warn": "#ff8a80",
      "marker_edge": "#003b73",
      "valve": "#ffffff"
    },
    "paper": {
      "_comment": "Same picture on white for print.",
      "background": "#ffffff",
      "panel": "#ffffff",
      "ink": "#333333",
      "cell": "#333333",
      "muted": "#6b7686",
      "grid": "#e3e7ec",
      "window": "#e4f1fa",
      "warn": "#d9534f",
      "marker_edge": "#003b73",
      "valve": "#003b73"
    }
  },
  "default_theme": "site",
  "alpha": {
    "water": 0.85,
    "fresh": 0.55
  },
  "linewidth": {
    "curve": 1.6,
    "tank": 1.6,
    "thin": 0.6,
    "valve_min": 0.6,
    "valve_max": 2.6
  },
  "font": {
    "family": ["Inter", "Helvetica", "Arial", "DejaVu Sans"],
    "size": 8
  },
  "geometry": {
    "smooth_window_V": 0.025,
    "min_dU_V": 0.004,
    "width_cap": 4.0,
    "slot_fill": 0.62,
    "riser_width": 0.09,
    "zoom_min_span_V": 0.1,
    "zoom_margin": 0.12
  },
  "figure_mm": {
    "single": 85,
    "double": 170
  }
}
