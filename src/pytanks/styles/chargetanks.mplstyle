# chargetanks.mplstyle - publication defaults in the chargetanks.com look
# Use for your own plots:  plt.style.use(pytanks.style_path())

font.family: sans-serif
font.sans-serif: Inter, Helvetica, Arial, DejaVu Sans
font.size: 8
axes.titlesize: 8
axes.titleweight: bold
axes.labelsize: 8
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
legend.frameon: False

text.color: 333333
axes.labelcolor: 333333
axes.edgecolor: 6b7686
axes.linewidth: 0.6
axes.spines.top: False
axes.spines.right: False
axes.grid: False
axes.prop_cycle: cycler('color', ['70ad47', 'f39c12', '5dade2', '003b73', 'd9534f', '6b7686'])
xtick.color: 6b7686
ytick.color: 6b7686
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.major.size: 2.5
ytick.major.size: 2.5

lines.linewidth: 1.5
lines.solid_capstyle: round
patch.linewidth: 0.6

figure.constrained_layout.use: True
figure.dpi: 150
savefig.dpi: 600
savefig.bbox: tight
savefig.pad_inches: 0.02
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
